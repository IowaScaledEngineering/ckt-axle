{
    "layout": {
        "type": "grid",
        "rows": 3,
        "cols": 1,
        "space": "100mil",
    },
    "tabs": {
        "type": "fixed",
        "width": "100mil",
    },
    "cuts": {
        "type": "mousebites",
        "drill": "0.5mm",
        "spacing": "0.75mm",
        "offset": "0mm",
    },
    "framing": {
        "type": "railslr",
        "cuts": "none",
        "space": "100mil",
        "width": "200mil",
    },
    "fiducials": {
        "type": "3fid",
        "hoffset": "100mil",
        "voffset": "300mil",
        "coppersize": "1mm",
        "opening": "2mm",
    },
    "post": {
        "millradius": "50mil",
    },
    "copperfill": {
        "type": "solid",
        "clearance": "100mil",
        "layers": "F.Cu",
    },
}
